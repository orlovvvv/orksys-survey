# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/orksys-survey

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars
BETTER_AUTH_URL=http://localhost:3001

# Polar Payments (get from https://sandbox.polar.sh/)
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_SUCCESS_URL=http://localhost:3001/success?checkout_id={CHECKOUT_ID}

# CORS
CORS_ORIGIN=http://localhost:3001

# Environment
NODE_ENV=development

# Expo Native App
# Use your local IP for physical device testing (e.g., 192.168.1.x)
EXPO_PUBLIC_SERVER_URL=http://localhost:3001
